{
  "name": "solarlearn-vr-server",
  "version": "1.0.0",
  "description": "Backend for SolarLearn VR PWA with WebXR and AI voice translation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "download-models": "node download-models.js",
    "setup": "npm run download-models && echo 'Setup complete! Copy env.example to .env and configure your API keys.'"
  },
  "dependencies": {
    "@huggingface/inference": "^4.7.1",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "gtts": "^0.2.1",
    "lru-cache": "^10.0.1",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "webxr",
    "vr",
    "solar-system",
    "voice-translation",
    "pwa",
    "multilingual",
    "indian-languages"
  ],
