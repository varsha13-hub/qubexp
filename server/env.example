# Server Configuration
PORT=8080
NODE_ENV=development

# Vosk Speech Recognition Models
# Download models from: https://alphacephei.com/vosk/models
VOSK_MODEL_PATH_EN=./src/stt/models/vosk-model-small-en-us-0.15
VOSK_MODEL_PATH_HI=./src/stt/models/vosk-model-small-hi-0.22
VOSK_MODEL_PATH_KN=./src/stt/models/vosk-model-small-kn-0.22
VOSK_MODEL_PATH_TA=./src/stt/models/vosk-model-small-ta-0.22
VOSK_MODEL_PATH_TE=./src/stt/models/vosk-model-small-te-0.22
VOSK_MODEL_PATH_MR=./src/stt/models/vosk-model-small-mr-0.22
VOSK_MODEL_PATH_BN=./src/stt/models/vosk-model-small-bn-0.22
VOSK_MODEL_PATH_ES=./src/stt/models/vosk-model-small-es-0.42
VOSK_MODEL_PATH_FR=./src/stt/models/vosk-model-small-fr-0.22
VOSK_MODEL_PATH_DE=./src/stt/models/vosk-model-small-de-0.21

# Translation Services
# Google Translate API (recommended for Indian languages)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Microsoft Translator (alternative)
MICROSOFT_TRANSLATOR_KEY=your_microsoft_translator_key_here
MICROSOFT_TRANSLATOR_REGION=global

# Cloud Speech-to-Text Services (fallback)
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here
AZURE_SPEECH_KEY=your_azure_speech_key_here

# Text-to-Speech Services
AZURE_SPEECH_REGION=your_azure_speech_region_here

# Cache Configuration
TRANSLATION_CACHE_SIZE=1000
TRANSLATION_CACHE_TTL=3600000

# LibreTranslate Configuration (if using self-hosted)
LIBRE_TRANSLATE_URL=https://libretranslate.com/translate
LIBRE_TRANSLATE_API_KEY=your_libre_translate_api_key_here

# MyMemory Configuration
MYMEMORY_API_KEY=your_mymemory_api_key_here

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://yourdomain.com

# Hugging Face API Configuration
HF_TOKEN=your_huggingface_token_here



# AI Service Priority (set to 'huggingface' to use Hugging Face as primary)
PRIMARY_AI_PROVIDER=huggingface

# Enhanced AI Service Configuration
AI_SERVICE_URL=http://localhost:8090

# Sarvam AI Configuration
SARVAM_KEY=your_sarvam_api_key_here
